APP_NAME=SIGAPP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DOMAIN=sigapp.com.br
CENTRAL_DOMAINS=localhost,127.0.0.1,sigapp-backend
TENANCY_RESERVED_SUBDOMAINS=smtp,mail,imap,pop3,autodiscover,autoconfig,cdn,assets,status,support,docs,billing,auth,static

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
APP_PREVIOUS_KEYS=
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug

# Banco central e schemas dos tenants (PostgreSQL)
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=database
DB_PORT=5432
DB_DATABASE=sigapp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8
DB_SEARCH_PATH=public
DB_SSLMODE=prefer
TENANCY_CENTRAL_CONNECTION=central
TENANCY_TEMPLATE_TENANT_CONNECTION=tenant_template
TENANCY_HOST_CONNECTION=tenant_host_connection
TENANCY_TEMPLATE_SEARCH_PATH=public
TENANCY_HOST_SEARCH_PATH=public
TENANCY_DATABASE_PREFIX=tenant_

# Sessão, cache e filas
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
TRUSTED_PROXIES=
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
REDIS_QUEUE_RETRY_AFTER=660
REDIS_QUEUE_BLOCK_FOR=5
QUEUE_TENANT_PROVISIONING_PROCESSES=1
QUEUE_AI_PROCESSES=1
QUEUE_EXPORTS_PROCESSES=1
QUEUE_NOTIFICATIONS_PROCESSES=1
QUEUE_DEFAULT_PROCESSES=1
CACHE_STORE=redis
CACHE_PREFIX=

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

# E-mail
MAIL_MAILER=failover
RESEND_API_KEY=
MAIL_FROM_ADDRESS=admin@sigapp.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Storage S3/R2. Documentos, relatórios e exports usam o disk s3 explicitamente.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe/Cashier
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_PRICE_BROKER=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_MASTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ADDON_STORAGE_10GB=
STRIPE_PRICE_ADDON_AI_BUDGET_5=
STRIPE_PRICE_ADDON_REPORTS_BUILDER=
STRIPE_PRICE_ADDON_GROWTH_BUNDLE=
CASHIER_CURRENCY=brl
CASHIER_CURRENCY_LOCALE=pt_BR
CASHIER_PAYMENT_NOTIFICATION=App\Notifications\PaymentRequiresActionNotification
STRIPE_PORTAL_CONFIGURATION_ID=

# URLs e autenticação web
API_VERSION=0.0.1
FRONTEND_URL=http://localhost:8080
LANDING_URL=http://localhost:8081
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:8081,localhost:3000,sigapp.test,*.sigapp.test
SANCTUM_TOKEN_PREFIX=
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000

# Agente SIG_IA
AI_PROVIDER=deepseek
AI_FALLBACK_PROVIDER=
AI_FALLBACK_AGENT_MODEL=
AI_TENANT_BUDGET_DEFAULT=10
AI_AGENT_BUDGET_RESERVATION_USD=0.25
AI_EMBEDDING_BUDGET_RESERVATION_USD=0.001
AI_DOCUMENT_BUDGET_RESERVATION_USD=0.05
AI_BUDGET_RESERVATION_TTL_MINUTES=15
AI_RATE_LIMIT_PER_MINUTE=30
AI_PDF_RATE_LIMIT_PER_HOUR=10
AI_PDF_MAX_HTML_CHARS=150000
AI_MERCADO_RATE_LIMIT_PER_HOUR=10
DEEPSEEK_API_KEY=
AI_DEEPSEEK_AGENT_MODEL=deepseek-v4-flash
GEMINI_API_KEY=
AI_GEMINI_AGENT_MODEL=gemini-2.5-flash-native-audio-dialog
OPENROUTER_API_KEY=
AI_OPENROUTER_AGENT_MODEL=z-ai/glm-4.5-air:free

# Análise documental (OpenCode Go / GPT-5.6 Luna)
AI_DOCUMENT_PROVIDER=opencode_go
AI_DOCUMENT_MODEL=gpt-5.6-luna
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
AI_DOCUMENT_TIMEOUT_SECONDS=120
AI_DOCUMENT_MAX_BYTES=10485760
AI_DOCUMENT_MAX_PAGES=30

# Preços de IA por 1M tokens (USD)
AI_DEEPSEEK_INPUT_PRICE_PER_M=0.0028
AI_DEEPSEEK_INPUT_CACHE_MISS_PRICE_PER_M=0.14
AI_DEEPSEEK_OUTPUT_PRICE_PER_M=0.28
AI_OPENROUTER_INPUT_PRICE_PER_M=0
AI_OPENROUTER_OUTPUT_PRICE_PER_M=0
AI_GEMINI_INPUT_PRICE_PER_M=0
AI_GEMINI_OUTPUT_PRICE_PER_M=0
AI_ANTHROPIC_INPUT_PRICE_PER_M=3
AI_ANTHROPIC_OUTPUT_PRICE_PER_M=15
AI_OPENAI_INPUT_PRICE_PER_M=2.5
AI_OPENAI_OUTPUT_PRICE_PER_M=10
AI_OPENCODE_GO_INPUT_PRICE_PER_M=0.2
AI_OPENCODE_GO_OUTPUT_PRICE_PER_M=1.2

# Embeddings
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_MIN_SIMILARITY=0.35
OPENAI_API_KEY=
AI_OPENAI_EMBEDDING_PRICE_PER_M=0.02
AI_AZURE_EMBEDDING_PRICE_PER_M=0.02
AI_GEMINI_EMBEDDING_PRICE_PER_M=0
AI_MISTRAL_EMBEDDING_PRICE_PER_M=0
AI_COHERE_EMBEDDING_PRICE_PER_M=0
AI_JINA_EMBEDDING_PRICE_PER_M=0
AI_VOYAGEAI_EMBEDDING_PRICE_PER_M=0

# Mapas, elevação e integrações auxiliares
ELEVATION_PROVIDER=open-elevation
GOOGLE_MAPS_API_KEY=
OPENTOPOGRAPHY_KEY=
SERPER_API_KEY=
PORTAL_TERRENOS_USERNAME=
PORTAL_TERRENOS_PASSWORD=
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium
BROWSERSHOT_NO_SANDBOX=false
CONSENT_LOG_RETENTION_DAYS=180
PRIVACY_DPO_EMAIL=dpo@sigapp.com.br
PRIVACY_CANCELLED_TENANT_RETENTION_DAYS=90
PRIVACY_SOFT_DELETE_RETENTION_DAYS=90
PRIVACY_AI_LOG_RETENTION_DAYS=90
PRIVACY_EXPORT_TTL_HOURS=24
PRIVACY_REQUEST_RETENTION_YEARS=5
PRIVACY_AUTO_WIPE_ENABLED=false
TENANT_KEK_DRIVER=local
TENANT_KEK_ARN=

# Administrador central inicial
CENTRAL_ADMIN_NAME="Admin Central"
CENTRAL_ADMIN_EMAIL=admin@sigapp.com.br
CENTRAL_ADMIN_PASSWORD=

# Providers opcionais do Laravel AI SDK (preencha apenas se selecionados)
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_URL=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
COHERE_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
JINA_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
VOYAGEAI_API_KEY=
XAI_API_KEY=

# Push e YouTrack são integrações opcionais
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# Scripts opcionais de integração com YouTrack
YOUTRACK_BASE_URL=https://sigapp.youtrack.cloud
YOUTRACK_TOKEN=
YOUTRACK_PROJECT_ID=0-1

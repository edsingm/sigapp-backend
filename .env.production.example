APP_NAME=SIGAPP
APP_ENV=production
APP_KEY=base64:GENERATE_A_UNIQUE_KEY
APP_DEBUG=false
APP_URL=https://api.sigapp.com.br
APP_DOMAIN=sigapp.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
APP_PREVIOUS_KEYS=

# Inclua os hosts centrais e o hostname interno exato do serviço backend no Dokploy (se usado em CENTRAL_DOMAINS).
CENTRAL_DOMAINS=sigapp.com.br,www.sigapp.com.br,app.sigapp.com.br,admin.sigapp.com.br,api.sigapp.com.br,BACKEND_INTERNAL_HOST
TENANCY_RESERVED_SUBDOMAINS=smtp,mail,imap,pop3,autodiscover,autoconfig,cdn,assets,status,support,docs,billing,auth,static

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Banco central e schemas dos tenants
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=POSTGRES_INTERNAL_HOST
DB_PORT=5432
DB_DATABASE=sigapp
DB_USERNAME=sigapp
DB_PASSWORD=GENERATE_A_STRONG_PASSWORD
DB_CHARSET=utf8
DB_SEARCH_PATH=public
DB_SSLMODE=prefer
TENANCY_CENTRAL_CONNECTION=central
TENANCY_TEMPLATE_TENANT_CONNECTION=tenant_template
TENANCY_HOST_CONNECTION=tenant_host_connection
TENANCY_TEMPLATE_SEARCH_PATH=public
TENANCY_HOST_SEARCH_PATH=public
TENANCY_DATABASE_PREFIX=tenant_
# Só compose de staging: nome da rede Docker do Postgres (docker network ls).
# Ex.: sigapp-database-staging_default. Obrigatório em docker-compose.staging.yml.
DATABASE_DOCKER_NETWORK=

# Sessão, cache e filas
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=SET_TO_COOLIFY_PROXY_IP_OR_CIDR
CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=660
REDIS_QUEUE_BLOCK_FOR=5
QUEUE_TENANT_PROVISIONING_PROCESSES=1
QUEUE_AI_PROCESSES=1
QUEUE_EXPORTS_PROCESSES=1
QUEUE_NOTIFICATIONS_PROCESSES=1
QUEUE_DEFAULT_PROCESSES=1
REDIS_CLIENT=phpredis
REDIS_HOST=REDIS_INTERNAL_HOST
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_A_STRONG_PASSWORD
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

# URLs, Sanctum e CORS
API_VERSION=0.0.1
FRONTEND_URL=https://app.sigapp.com.br
LANDING_URL=https://sigapp.com.br
SANCTUM_STATEFUL_DOMAINS=sigapp.com.br,www.sigapp.com.br,app.sigapp.com.br,admin.sigapp.com.br,api.sigapp.com.br,*.sigapp.com.br
SANCTUM_TOKEN_PREFIX=
CORS_ALLOWED_ORIGINS=https://sigapp.com.br,https://www.sigapp.com.br,https://app.sigapp.com.br,https://admin.sigapp.com.br

# Storage privado S3/R2
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=SET_IN_DOKPLOY
AWS_SECRET_ACCESS_KEY=SET_IN_DOKPLOY
AWS_DEFAULT_REGION=auto
AWS_BUCKET=SET_IN_DOKPLOY
AWS_URL=
AWS_ENDPOINT=SET_IN_DOKPLOY
AWS_USE_PATH_STYLE_ENDPOINT=true

# E-mail
MAIL_MAILER=resend
RESEND_API_KEY=SET_IN_DOKPLOY
MAIL_FROM_ADDRESS=admin@sigapp.com.br
MAIL_FROM_NAME=SIGAPP

# Stripe/Cashier
STRIPE_KEY=SET_IN_DOKPLOY
STRIPE_SECRET=SET_IN_DOKPLOY
STRIPE_WEBHOOK_SECRET=SET_IN_DOKPLOY
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_PRICE_BROKER=SET_IN_DOKPLOY
STRIPE_PRICE_BASICO=SET_IN_DOKPLOY
STRIPE_PRICE_MASTER=SET_IN_DOKPLOY
STRIPE_PRICE_PRO=SET_IN_DOKPLOY
STRIPE_PRICE_ADDON_STORAGE_10GB=SET_IN_DOKPLOY
STRIPE_PRICE_ADDON_AI_BUDGET_5=SET_IN_DOKPLOY
STRIPE_PRICE_ADDON_REPORTS_BUILDER=SET_IN_DOKPLOY
STRIPE_PRICE_ADDON_GROWTH_BUNDLE=SET_IN_DOKPLOY
CASHIER_CURRENCY=brl
CASHIER_CURRENCY_LOCALE=pt_BR
CASHIER_PAYMENT_NOTIFICATION=App\Notifications\PaymentRequiresActionNotification
STRIPE_PORTAL_CONFIGURATION_ID=

# Agente SIG_IA
AI_PROVIDER=deepseek
AI_FALLBACK_PROVIDER=
AI_FALLBACK_AGENT_MODEL=
AI_TENANT_BUDGET_DEFAULT=10
AI_AGENT_BUDGET_RESERVATION_USD=0.25
AI_EMBEDDING_BUDGET_RESERVATION_USD=0.001
AI_DOCUMENT_BUDGET_RESERVATION_USD=0.05
AI_BUDGET_RESERVATION_TTL_MINUTES=15
AI_RATE_LIMIT_PER_MINUTE=30
AI_PDF_RATE_LIMIT_PER_HOUR=10
AI_PDF_MAX_HTML_CHARS=150000
AI_MERCADO_RATE_LIMIT_PER_HOUR=10
DEEPSEEK_API_KEY=SET_IN_DOKPLOY
AI_DEEPSEEK_AGENT_MODEL=deepseek-v4-flash
GEMINI_API_KEY=
AI_GEMINI_AGENT_MODEL=gemini-2.5-flash-native-audio-dialog
OPENROUTER_API_KEY=
AI_OPENROUTER_AGENT_MODEL=z-ai/glm-4.5-air:free

# Análise documental (OpenCode Go / GPT-5.6 Luna)
AI_DOCUMENT_PROVIDER=opencode_go
AI_DOCUMENT_MODEL=gpt-5.6-luna
OPENCODE_GO_API_KEY=SET_IN_DOKPLOY
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
AI_DOCUMENT_TIMEOUT_SECONDS=120
AI_DOCUMENT_MAX_BYTES=10485760
AI_DOCUMENT_MAX_PAGES=30

# Preços de IA por 1M tokens (USD)
AI_DEEPSEEK_INPUT_PRICE_PER_M=0.0028
AI_DEEPSEEK_INPUT_CACHE_MISS_PRICE_PER_M=0.14
AI_DEEPSEEK_OUTPUT_PRICE_PER_M=0.28
AI_OPENROUTER_INPUT_PRICE_PER_M=0
AI_OPENROUTER_OUTPUT_PRICE_PER_M=0
AI_GEMINI_INPUT_PRICE_PER_M=0
AI_GEMINI_OUTPUT_PRICE_PER_M=0
AI_ANTHROPIC_INPUT_PRICE_PER_M=3
AI_ANTHROPIC_OUTPUT_PRICE_PER_M=15
AI_OPENAI_INPUT_PRICE_PER_M=2.5
AI_OPENAI_OUTPUT_PRICE_PER_M=10
AI_OPENCODE_GO_INPUT_PRICE_PER_M=0.2
AI_OPENCODE_GO_OUTPUT_PRICE_PER_M=1.2

# Embeddings
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_MIN_SIMILARITY=0.35
OPENAI_API_KEY=
AI_OPENAI_EMBEDDING_PRICE_PER_M=0.02
AI_AZURE_EMBEDDING_PRICE_PER_M=0.02
AI_GEMINI_EMBEDDING_PRICE_PER_M=0
AI_MISTRAL_EMBEDDING_PRICE_PER_M=0
AI_COHERE_EMBEDDING_PRICE_PER_M=0
AI_JINA_EMBEDDING_PRICE_PER_M=0
AI_VOYAGEAI_EMBEDDING_PRICE_PER_M=0

# Mapas, elevação e integrações auxiliares
ELEVATION_PROVIDER=open-elevation
GOOGLE_MAPS_API_KEY=
OPENTOPOGRAPHY_KEY=
SERPER_API_KEY=
PORTAL_TERRENOS_USERNAME=
PORTAL_TERRENOS_PASSWORD=
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium
BROWSERSHOT_NO_SANDBOX=true
CONSENT_LOG_RETENTION_DAYS=180
PRIVACY_DPO_EMAIL=dpo@sigapp.com.br
PRIVACY_CANCELLED_TENANT_RETENTION_DAYS=90
PRIVACY_SOFT_DELETE_RETENTION_DAYS=90
PRIVACY_AI_LOG_RETENTION_DAYS=90
PRIVACY_EXPORT_TTL_HOURS=24
PRIVACY_REQUEST_RETENTION_YEARS=5
PRIVACY_AUTO_WIPE_ENABLED=false
TENANT_KEK_DRIVER=local
TENANT_KEK_ARN=

# Administrador central inicial
CENTRAL_ADMIN_NAME="Admin Central"
CENTRAL_ADMIN_EMAIL=SET_IN_DOKPLOY
CENTRAL_ADMIN_PASSWORD=GENERATE_A_STRONG_PASSWORD

# Providers opcionais do Laravel AI SDK
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_URL=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
COHERE_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
JINA_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
VOYAGEAI_API_KEY=
XAI_API_KEY=

# Push opcional
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# Readiness, heartbeats de workers e gate de schema no startup
OPERATIONS_HEARTBEAT_MAX_AGE_SECONDS=180
OPERATIONS_QUEUE_LAG_MAX_SECONDS=120
SIGAPP_RELEASE_ON_STARTUP=true

# IA — Hardening (Fase 0)
AI_FALLBACK_PROVIDER=
AI_FALLBACK_AGENT_MODEL=
AI_TENANT_BUDGET_DEFAULT=
AI_AGENT_BUDGET_RESERVATION_USD=0.25
AI_EMBEDDING_BUDGET_RESERVATION_USD=0.001
AI_DOCUMENT_BUDGET_RESERVATION_USD=0.05
AI_BUDGET_RESERVATION_TTL_MINUTES=15
AI_RATE_LIMIT_PER_MINUTE=

# IA — Análise documental (OpenCode Go / GPT-5.6 Luna) — não usa o modelo do chat SIG IA
AI_DOCUMENT_PROVIDER=opencode_go
AI_DOCUMENT_MODEL=gpt-5.6-luna
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
AI_DOCUMENT_TIMEOUT_SECONDS=120
AI_DOCUMENT_MAX_BYTES=10485760
AI_DOCUMENT_MAX_PAGES=30

# IA — Preços por 1M tokens (USD) para estimativa de custo
AI_DEEPSEEK_INPUT_PRICE_PER_M=0.0028
AI_DEEPSEEK_INPUT_CACHE_MISS_PRICE_PER_M=0.14
AI_DEEPSEEK_OUTPUT_PRICE_PER_M=0.28
AI_OPENROUTER_INPUT_PRICE_PER_M=
AI_OPENROUTER_OUTPUT_PRICE_PER_M=
AI_GEMINI_INPUT_PRICE_PER_M=
AI_GEMINI_OUTPUT_PRICE_PER_M=
AI_ANTHROPIC_INPUT_PRICE_PER_M=
AI_ANTHROPIC_OUTPUT_PRICE_PER_M=
AI_OPENAI_INPUT_PRICE_PER_M=
AI_OPENAI_OUTPUT_PRICE_PER_M=
AI_OPENCODE_GO_INPUT_PRICE_PER_M=0.20
AI_OPENCODE_GO_OUTPUT_PRICE_PER_M=1.20

# IA — Embeddings (Fase 2)
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=

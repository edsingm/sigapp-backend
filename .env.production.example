APP_NAME=SIGAPP
APP_ENV=production
APP_KEY=base64:GENERATE_A_UNIQUE_KEY
APP_DEBUG=false
APP_URL=https://api.sigapp.com.br
APP_DOMAIN=sigapp.com.br
# Include the exact internal backend hostname generated by Coolify.
CENTRAL_DOMAINS=sigapp.com.br,api.sigapp.com.br,app.sigapp.com.br,BACKEND_INTERNAL_HOST

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=POSTGRES_INTERNAL_HOST
DB_PORT=5432
DB_DATABASE=sigapp
DB_USERNAME=sigapp
DB_PASSWORD=GENERATE_A_STRONG_PASSWORD
DB_SSLMODE=prefer

TENANCY_CENTRAL_CONNECTION=central
TENANCY_TEMPLATE_TENANT_CONNECTION=tenant_template
TENANCY_HOST_CONNECTION=tenant_host_connection
TENANCY_TEMPLATE_SEARCH_PATH=public
TENANCY_HOST_SEARCH_PATH=public
TENANCY_DATABASE_PREFIX=tenant_

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=SET_TO_COOLIFY_PROXY_IP_OR_CIDR
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=660
REDIS_QUEUE_BLOCK_FOR=5
QUEUE_TENANT_PROVISIONING_PROCESSES=1
QUEUE_AI_PROCESSES=1
QUEUE_EXPORTS_PROCESSES=1
QUEUE_NOTIFICATIONS_PROCESSES=1
QUEUE_DEFAULT_PROCESSES=1
REDIS_HOST=REDIS_INTERNAL_HOST
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_A_STRONG_PASSWORD

FRONTEND_URL=https://app.sigapp.com.br
LANDING_URL=https://sigapp.com.br
SANCTUM_STATEFUL_DOMAINS=sigapp.com.br,app.sigapp.com.br,admin.sigapp.com.br,*.sigapp.com.br
CORS_ALLOWED_ORIGINS=https://sigapp.com.br,https://www.sigapp.com.br,https://app.sigapp.com.br,https://admin.sigapp.com.br

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=SET_IN_COOLIFY
AWS_SECRET_ACCESS_KEY=SET_IN_COOLIFY
AWS_DEFAULT_REGION=SET_IN_COOLIFY
AWS_BUCKET=SET_IN_COOLIFY
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=resend
RESEND_API_KEY=SET_IN_COOLIFY
MAIL_FROM_ADDRESS=contato@sigapp.com.br
MAIL_FROM_NAME=SIGAPP

STRIPE_KEY=SET_IN_COOLIFY
STRIPE_SECRET=SET_IN_COOLIFY
STRIPE_WEBHOOK_SECRET=SET_IN_COOLIFY
CASHIER_CURRENCY=brl
STRIPE_PORTAL_CONFIGURATION_ID=

CENTRAL_ADMIN_NAME=Admin Central
CENTRAL_ADMIN_EMAIL=SET_IN_COOLIFY
CENTRAL_ADMIN_PASSWORD=GENERATE_A_STRONG_PASSWORD

AI_PROVIDER=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_MAPS_API_KEY=
